datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(BUSINESS_OWNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  companyId       String?
  passkeyEnabled  Boolean   @default(false)
  passkeyPrompted Boolean   @default(false)
  mfaEnabled      Boolean   @default(false)
  hasSeenTour     Boolean   @default(false)
  mfaSecret       String?
  isBlocked       Boolean   @default(false)
  isPro           Boolean   @default(false)
  proExpiry       DateTime?
  dashboardConfig Json?

  // Referral system
  referralCode         String?   @unique  // e.g. "INV-AB12CD34"
  referredBy           String?            // referral code used at signup
  referralRewardClaimed Boolean  @default(false) // true once 1-month Pro reward is granted

  company        Company?        @relation(fields: [companyId], references: [id])
  accounts       Account[]
  sessions       Session[]
  Authenticators Authenticator[]
  auditLogs      AuditLog[]
  aichatSessions AIChatSession[]
  pushSubscriptions PushSubscription[]
  feedbacks      UserFeedback[]
  featureRequests FeatureRequest[]
  featureRequestComments FeatureRequestComment[]
  featureRequestUpvotes  FeatureRequestUpvote[]
  referralRedemptions ReferralRedemption[] @relation("ReferrerRedemptions")

  // CRM relations
  assignedCrmLeads      CrmLead[]        @relation("AssignedLeads")
  assignedCrmDeals      CrmDeal[]        @relation("AssignedDeals")
  assignedCrmActivities CrmActivity[]    @relation("AssignedActivities")
  createdCrmWorkflows   CrmWorkflow[]    @relation("CreatedWorkflows")

  @@index([companyId])
  @@index([email])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  BUSINESS_OWNER
  STAFF
  USER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Domain Models
enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

model Company {
  id             String    @id @default(cuid())
  name           String
  gstNumber      String?
  panNumber      String?
  cinNumber      String?
  logo           String?
  address        String?
  state          String?
  email          String?
  phone          String?
  website        String?
  taxPreferences Json?
  invoicePrefix  String?   @default("INV")
  baseCurrency   String?   @default("INR")
  invoiceTemplate String?  @default("modern")
  subscriptionTier SubscriptionTier @default(FREE)
  customDomain   String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  autoFreezeMonths Int?

  msmeNumber      String?
  msmeType        String?
  tcsRate         Float?    @default(0)
  webhooks        Webhook[]

  users          User[]
  customers      Customer[]
  invoices       Invoice[]
  quotations     Quotation[]
  bankAccounts   BankAccount[]
  emailSetting   EmailSetting?
  aiSettings     AISettings?
  auditLogs      AuditLog[]
  aichatSessions AIChatSession[]
  catalog        ProductCatalog[]
  emailLogs      EmailLog[]
  reminderConfig ReminderConfig?
  expenses       Expense[]
  feedbacks      UserFeedback[]
  testCertificates TestCertificate[]
  teamInvitations TeamInvitation[]
  apiKeys        ApiKey[]
  testimonials   Testimonial[]
  backups        CompanyBackup[]

  // CRM Suite relations
  crmLeads        CrmLead[]
  crmDeals        CrmDeal[]
  crmStages       CrmStage[]
  crmActivities   CrmActivity[]
  crmWorkflows    CrmWorkflow[]
  crmWorkflowLogs CrmWorkflowLog[]
  crmCampaigns    CrmCampaign[]
  crmEmailLogs    CrmEmailLog[]
  
  slug              String?   @unique
  tagline           String?
  description       String?
  twitterUrl        String?
  linkedinUrl       String?
  instagramUrl      String?
  githubUrl         String?
  
  removeWatermark   Boolean   @default(false)
  showCompanyInEmailFooter Boolean @default(false)
  customDbUrlEncrypted String?
  trialStartsAt     DateTime?
  trialEndsAt       DateTime?
  vpaAddress        String?
  cryptoAddress     String?
  cryptoNetwork     String?
  razorpayKeyId     String?
  razorpayKeySecret String?
  razorpayWebhookSecret String?
  trialReminderSent DateTime?
  openWaEnabled     Boolean   @default(false)
  openWaUrl         String?
  openWaToken       String?

  proRequestStatus  String?  // PENDING, APPROVED, REJECTED

  whatsappProvider       String   @default("openwa") // "openwa" | "official"
  whatsappPhoneId        String?  // Meta Phone Number ID
  whatsappMetaToken      String?  // Encrypted token
  whatsappSentCount      Int      @default(0)    // usage tracking

  @@index([gstNumber])
}

model Testimonial {
  id          String   @id @default(cuid())
  companyId   String
  clientName  String
  clientRole  String?
  content     String
  rating      Int      @default(5)
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Customer {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  companyName String?
  gstin       String?
  pan         String?
  address     String?
  state       String?
  country     String?   @default("India")
  email       String?
  phone       String?
  showContactPersonName Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  crmStatus   String                 @default("LEAD")
  interactions CustomerInteraction[]

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  quotations Quotation[]
  testCertificates TestCertificate[]

  // CRM Suite relations
  deals           CrmDeal[]
  crmActivities   CrmActivity[]
  leads           CrmLead[]

  @@index([companyId])
  @@index([name])
  @@index([gstin])
}

model CustomerInteraction {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String   // NOTE, CALL, EMAIL, WHATSAPP
  content     String
  createdAt   DateTime @default(now())

  @@index([customerId])
}

model Invoice {
  id                String        @id @default(cuid())
  companyId         String
  customerId        String
  invoiceNumber     String
  date              DateTime
  dueDate           DateTime
  currency          String        @default("INR")
  notes             String?
  terms             String?
  internalNotes     String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfscCode      String?
  bankAccountType   String?
  themeColor        String?       @default("#1e40af")
  themeFont         String?       @default("Helvetica")
  status            InvoiceStatus @default(DRAFT)
  exchangeRate      Float         @default(1)
  isFrozen          Boolean       @default(false)

  subTotal      Float
  totalDiscount Float   @default(0)
  totalTax      Float
  taxJurisdiction String @default("INDIA_GST")
  cgstAmount    Float   @default(0)
  sgstAmount    Float   @default(0)
  igstAmount    Float   @default(0)
  vatAmount     Float   @default(0)
  tdsPercentage Float   @default(0)
  tdsAmount     Float   @default(0)
  tcsRate       Float   @default(0)
  tcsAmount      Float   @default(0)
  finalAmount   Float
  amountPaid    Float   @default(0)
  balanceDue    Float   @default(0)
  pdfUrl        String?
  paymentCollectionMethod String @default("OFFLINE")
  vpaAddress              String?
  cryptoAddress           String?
  cryptoNetwork           String?
  razorpayOrderId         String?
  razorpayPaymentLinkId   String?
  razorpayPaymentLinkUrl  String?
  verificationToken       String?   @unique
  pdfHash                 String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]
  payments      Payment[]
  testCertificates TestCertificate[]
  emailLogs     EmailLog[]
  schedule      RecurringSchedule?
  statusHistory InvoiceStatusHistory[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([date])
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model InvoiceStatusHistory {
  id        String        @id @default(cuid())
  invoiceId String
  status    InvoiceStatus
  note      String?
  createdAt DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  description   String
  hsnSac        String?
  quantity      Float
  unitPrice     Float
  discount      Float   @default(0)
  taxPercentage Float   @default(18)
  taxableAmount Float   @default(0)
  taxAmount     Float   @default(0)
  total         Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  amount        Float
  paymentMethod PaymentMethod
  transactionId String?
  status        PaymentStatus @default(COMPLETED)
  date          DateTime      @default(now())
  notes         String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  RAZORPAY
  STRIPE
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model RecurringSchedule {
  id        String             @id @default(cuid())
  invoiceId String             @unique
  frequency RecurringFrequency
  nextRunAt DateTime
  autoSend  Boolean            @default(false)
  status    ScheduleStatus     @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model EmailSetting {
  id                String   @id @default(cuid())
  companyId         String   @unique
  host              String
  port              Int
  username          String
  passwordEncrypted String
  secure            Boolean  @default(true)
  fromEmail         String?
  fromName          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  action    String
  entity    String
  entityId  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([entity, entityId])
}

model BankAccount {
  id            String   @id @default(cuid())
  companyId     String
  bankName      String
  accountName   String
  accountNumber String
  ifscCode      String
  accountType   String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model AISettings {
  id            String   @id @default(cuid())
  companyId     String   @unique
  provider      String   @default("gemini")
  geminiKey     String?
  openaiKey     String?
  nvidiaKey     String?
  openrouterKey String?
  fallbackOrder String   @default("gemini,openai,nvidia,openrouter")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model AIChatSession {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  title     String   @default("New Invoice Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIChatMessage[]

  @@index([companyId])
  @@index([userId])
}

model AIChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant" | "system"
  content   String
  createdAt DateTime @default(now())

  session AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ProductCatalog {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  description   String?
  hsnSac        String?
  unitPrice     Float
  taxPercentage Float    @default(18)
  unit          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  
  company       Company  @relation(fields: [companyId], references: [id])
  
  @@index([companyId])
}

model EmailLog {
  id          String   @id @default(cuid())
  companyId   String
  invoiceId   String?
  to          String
  subject     String
  status      String   // "sent" | "failed"
  sentAt      DateTime @default(now())
  error       String?
  
  company     Company  @relation(fields: [companyId], references: [id])
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  
  @@index([companyId])
  @@index([invoiceId])
}

model ReminderConfig {
  id            String  @id @default(cuid())
  companyId     String  @unique
  day0Enabled   Boolean @default(true)
  day7Enabled   Boolean @default(true)
  day15Enabled  Boolean @default(false)
  customMessage String?
  
  company       Company @relation(fields: [companyId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  date        DateTime
  amount      Float
  category    String   // free-text
  description String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@index([companyId])
}

model Quotation {
  id                String          @id @default(cuid())
  companyId         String
  customerId        String
  quotationNumber   String
  date              DateTime
  expiryDate        DateTime?
  currency          String          @default("INR")
  notes             String?
  terms             String?
  themeColor        String?         @default("#1e40af")
  themeFont         String?         @default("Helvetica")
  status            QuotationStatus @default(DRAFT)
  exchangeRate      Float           @default(1)

  subTotal      Float
  totalDiscount Float   @default(0)
  totalTax      Float
  taxJurisdiction String @default("INDIA_GST")
  cgstAmount    Float   @default(0)
  sgstAmount    Float   @default(0)
  igstAmount    Float   @default(0)
  vatAmount     Float   @default(0)
  tdsPercentage Float   @default(0)
  tdsAmount     Float   @default(0)
  tcsRate       Float   @default(0)
  tcsAmount      Float   @default(0)
  finalAmount   Float
  pdfUrl        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    QuotationItem[]

  @@unique([companyId, quotationNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([date])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  INVOICED
}

model QuotationItem {
  id            String  @id @default(cuid())
  quotationId   String
  description   String
  hsnSac        String?
  quantity      Float
  unitPrice     Float
  discount      Float   @default(0)
  taxPercentage Float   @default(18)
  taxableAmount Float   @default(0)
  taxAmount     Float   @default(0)
  total         Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserFeedback {
  id        String   @id @default(cuid())
  userId    String
  companyId String?
  rating    Int      // 1 to 5
  comments  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

model TeamInvitation {
  id        String   @id @default(cuid())
  email     String
  companyId String
  role      Role     @default(STAFF)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([companyId])
  @@index([token])
}

model AppError {
  id        String   @id @default(cuid())
  message   String
  digest    String?
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PublicFeedback {
  id        String   @id @default(cuid())
  rating    Int      // 1 to 5
  comments  String?
  source    String   // "invoice-generator", "quotation-generator", etc.
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

model ApiKey {
  id        String    @id @default(cuid())
  name      String
  keyHash   String    @unique
  keyHint   String    // e.g. "op_inv_live_...abcd"
  companyId String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([keyHash])
}

// Referral System
model ReferralRedemption {
  id              String   @id @default(cuid())
  referrerId      String                        // User who owns the referral code
  referredUserId  String                        // Newly registered user
  referralCode    String                        // Code that was used
  rewardGranted   Boolean  @default(false)      // Pro month activated
  proGrantedAt    DateTime?                     // When Pro was activated
  createdAt       DateTime @default(now())

  referrer        User     @relation("ReferrerRedemptions", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referralCode])
}

model SystemConfig {
  id                       Int      @id @default(1)
  maintenanceMode          Boolean  @default(false)
  registrationOpen         Boolean  @default(true)
  systemLogLevel           String   @default("info")
  requireEmailVerification Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model Webhook {
  id        String       @id @default(cuid())
  companyId String
  url       String
  events    String       @default("invoice.created,invoice.paid")
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  logs      WebhookLog[]

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId])
}

model WebhookLog {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  url          String
  statusCode   Int?
  requestBody  String
  responseBody String?
  success      Boolean  @default(false)
  createdAt    DateTime @default(now())

  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  @@index([webhookId])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  from      String   @default("USD")
  to        String   @default("INR")
  rate      Float
  updatedAt DateTime @updatedAt

  @@unique([from, to])
}

model FeatureRequest {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  status      String   @default("Open") // Open, Under Review, Planned, In Progress, Complete, Closed, Acknowledged
  category    String?
  imageUrl    String?
  mergedIntoId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    FeatureRequestComment[]
  upvotes     FeatureRequestUpvote[]
  mergedInto  FeatureRequest? @relation("MergedRequests", fields: [mergedIntoId], references: [id])
  mergedRequests FeatureRequest[] @relation("MergedRequests")

  @@index([userId])
  @@index([status])
  @@index([mergedIntoId])
}

model FeatureRequestComment {
  id               String   @id @default(cuid())
  featureRequestId String
  userId           String
  content          String
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([featureRequestId])
  @@index([userId])
}

model FeatureRequestUpvote {
  id               String   @id @default(cuid())
  featureRequestId String
  userId           String
  createdAt        DateTime @default(now())

  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([featureRequestId, userId])
}



model TestCertificate {
  id                String    @id @default(cuid())
  companyId         String
  customerId        String
  invoiceId         String?
  certificateNumber String
  date              DateTime
  productName       String
  batchNumber       String?
  testedParameters  Json
  remarks           String?
  authorizedSignatory String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([certificateNumber])
}

model CompanyBackup {
  id         String   @id @default(cuid())
  companyId  String
  fileName   String
  backupType String   @default("COMPLETE") // COMPLETE or MODULE_WISE
  modules    String   // JSON array of modules
  counts     String   // JSON object of counts
  fileSize   Int      @default(0)
  payload    String   // Full JSON backup payload stored in database
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// CRM Suite Models
// ─────────────────────────────────────────────────────────────

model CrmLead {
  id                  String    @id @default(cuid())
  companyId           String
  name                String
  companyName         String?
  email               String?
  phone               String?
  title               String?
  source              String    @default("WEBSITE") // WEBSITE, REFERRAL, INBOUND, LINKEDIN, CAMPAIGN, COLD_CALL
  status              String    @default("NEW")     // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED
  score               Int       @default(10)
  region              String?   // e.g. Bengaluru, Mumbai, Delhi, Remote
  estimatedValue      Float?
  notes               String?
  assignedToId        String?
  convertedCustomerId String?
  convertedDealId     String?
  customFields        Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo          User?         @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedCustomer   Customer?     @relation(fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  convertedDeal       CrmDeal?      @relation("ConvertedFromLead")
  activities          CrmActivity[]

  @@index([companyId])
  @@index([status])
  @@index([assignedToId])
  @@index([convertedCustomerId])
}

model CrmStage {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  order       Int      @default(0)
  probability Int      @default(50) // 0-100%
  color       String   @default("#3b82f6")
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals       CrmDeal[]

  @@index([companyId])
  @@index([order])
}

model CrmDeal {
  id                String    @id @default(cuid())
  companyId         String
  title             String
  value             Float     @default(0)
  currency          String    @default("INR")
  stageId           String
  stageName         String?
  customerId        String?
  leadId            String?   @unique
  assignedToId      String?
  expectedCloseDate DateTime?
  probability       Int       @default(50)
  status            String    @default("OPEN") // OPEN, WON, LOST
  lossReason        String?
  notes             String?
  customFields      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stage             CrmStage      @relation(fields: [stageId], references: [id])
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead              CrmLead?      @relation("ConvertedFromLead", fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo        User?         @relation("AssignedDeals", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities        CrmActivity[]

  @@index([companyId])
  @@index([stageId])
  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
}

model CrmActivity {
  id           String    @id @default(cuid())
  companyId    String
  type         String    @default("TASK") // CALL, EMAIL, MEETING, NOTE, TASK
  title        String
  description  String?
  status       String    @default("TODO") // BACKLOG, TODO, IN_PROGRESS, IN_REVIEW, DONE, COMPLETED
  priority     String    @default("MEDIUM") // HIGHEST, HIGH, MEDIUM, LOW, LOWEST
  jiraKey      String?   // e.g. CRM-42
  comments     Json?     // Array of { id, authorName, heading, text, createdAt }
  subtasks     Json?     // Array of { id, key, title, completed, assigneeName, createdAt }
  history      Json?     // Array of { id, authorName, action, from, to, createdAt }
  dueDate      DateTime?
  completedAt  DateTime?
  assignedToId String?
  customerId   String?
  dealId       String?
  leadId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo   User?     @relation("AssignedActivities", fields: [assignedToId], references: [id], onDelete: SetNull)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal         CrmDeal?  @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead         CrmLead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([assignedToId])
  @@index([customerId])
  @@index([dealId])
  @@index([leadId])
  @@index([status])
}

model CrmCampaign {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  type           String    @default("EMAIL") // EMAIL, NEWSLETTER, PRODUCT_ANNOUNCEMENT, NURTURE
  status         String    @default("DRAFT") // DRAFT, SCHEDULED, ACTIVE, COMPLETED, PAUSED
  subject        String?
  content        String?
  targetAudience String?   @default("ALL_LEADS") // ALL_LEADS, QUALIFIED_LEADS, EXISTING_CUSTOMERS
  buttonText     String?   // Dynamic button label (e.g. "View Proposal", "Get Started")
  buttonUrl      String?   // Dynamic link destination (defaults to application link)
  sentCount      Int       @default(0)
  openCount      Int       @default(0)
  clickCount     Int       @default(0)
  scheduledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emailLogs      CrmEmailLog[]

  @@index([companyId])
  @@index([status])
}

model CrmEmailLog {
  id            String       @id @default(cuid())
  companyId     String
  campaignId    String?
  leadId        String?
  customerId    String?
  toEmail       String
  recipientName String?
  subject       String
  bodyPreview   String?
  buttonText    String?
  buttonUrl     String?
  status        String       // "SENT" | "FAILED"
  error         String?
  openedAt      DateTime?
  lastOpenedAt  DateTime?
  clickedAt     DateTime?
  lastClickedAt DateTime?
  ipAddress     String?
  userAgent     String?
  openEvents    Json?        @default("[]")
  clickEvents   Json?        @default("[]")
  openCount     Int          @default(0)
  clickCount    Int          @default(0)
  sentAt        DateTime     @default(now())

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign      CrmCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([campaignId])
  @@index([status])
  @@index([sentAt])
  @@index([openedAt])
  @@index([clickedAt])
  @@index([ipAddress])
}

model CrmWorkflow {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  description    String?
  triggerType    String    // LEAD_CREATED, LEAD_STATUS_CHANGED, DEAL_STAGE_CHANGED, DEAL_WON, ACTIVITY_OVERDUE, MANUAL
  triggerConfig  Json?
  conditions     Json      @default("[]") // Array of { field, operator, value }
  actions        Json      @default("[]") // Array of { actionType, config }
  isActive       Boolean   @default(true)
  isDraft        Boolean   @default(false)
  executionCount Int       @default(0)
  lastExecutedAt DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("CreatedWorkflows", fields: [createdById], references: [id], onDelete: SetNull)
  logs           CrmWorkflowLog[]

  @@index([companyId])
  @@index([isActive])
}

model CrmWorkflowLog {
  id              String      @id @default(cuid())
  workflowId      String
  companyId       String
  entityType      String      // LEAD, DEAL, CUSTOMER, ACTIVITY
  entityId        String
  status          String      // SUCCESS, FAILED, SKIPPED
  actionsExecuted Json
  error           String?
  executedAt      DateTime    @default(now())

  workflow        CrmWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([companyId])
  @@index([executedAt])
}


