# ==============================================================================
# Open-Invoice - Environment Variable Template (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Then fill in the required secrets (AUTH_SECRET, ENCRYPTION_KEY, ADMIN_SQL_PASSWORD).
# Generate random 32-byte hex keys with:
#   openssl rand -hex 32
# ==============================================================================

# Application Environment & Port
NODE_ENV="development"
PORT=3000

# Canonical Application URLs & Branding
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Open Invoice"
NEXT_PUBLIC_WHATSAPP_NO="919876543210"

# Application Mode: "selfhost" | "paid" | "enterprise"
APP_MODE="selfhost"

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# For SQLite (default local):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./data/invoice.db"

# For PostgreSQL (production or Docker):
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoice_saas"
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_CONNECTIONS=10

# Docker Compose credentials
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="invoice_saas"

# ------------------------------------------------------------------------------
# 2. Security & Encryption Keys (Required)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
AUTH_SECRET="your-auth-secret-min-32-chars-long"
ENCRYPTION_KEY="your-encryption-key-min-32-chars-long"
# PREVIOUS_ENCRYPTION_KEYS=""

# Super Admin Console direct SQL password (/admin)
ADMIN_SQL_PASSWORD="your-admin-sql-console-password"

# Cron API Endpoint Authorization Secret (/api/cron/recurring)
CRON_SECRET="your-cron-secret-token"

# ------------------------------------------------------------------------------
# 3. Web Push Notifications (VAPID Keys)
# ------------------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@openinvoice.com"

# ------------------------------------------------------------------------------
# 4. Cache & Memory Store (Valkey / Redis) - Optional
# ------------------------------------------------------------------------------
# VALKEY_URL="redis://localhost:6379"
# REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 5. Global System SMTP Email Service - Optional
# ------------------------------------------------------------------------------
# APP_SMTP_HOST="smtp.mailtrap.io"
# APP_SMTP_PORT=587
# APP_SMTP_USER="smtp-username"
# APP_SMTP_PASS="smtp-password"
# APP_SMTP_FROM="Open Invoice <noreply@openinvoice.com>"

# ------------------------------------------------------------------------------
# 6. Object Storage (S3 / Cloudflare R2 / MinIO) - Optional
# ------------------------------------------------------------------------------
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME="invoice-saas"

# ------------------------------------------------------------------------------
# 7. Razorpay Payment Gateway - Optional
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 8. OAuth Providers - Optional
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# APPLE_ID=""
# APPLE_SECRET=""

# ------------------------------------------------------------------------------
# 9. AI Providers - Optional
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 10. Indian GSTIN Verification APIs - Optional
# ------------------------------------------------------------------------------
# GST_CLIENT_ID=""
# GST_CLIENT_SECRET=""
# SANDBOX_API_KEY=""
# SANDBOX_API_SECRET=""

# ------------------------------------------------------------------------------
# 11. WhatsApp Integration - Optional ("openwa" or "official")
# ------------------------------------------------------------------------------
# WHATSAPP_PROVIDER="openwa"

# ------------------------------------------------------------------------------
# 12. Background Queues (Inngest) - Optional
# ------------------------------------------------------------------------------
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
